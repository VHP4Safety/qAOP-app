# Git
.git
.gitignore
.gitattributes

# CI / local tooling config
.github
.claude
CLAUDE.md

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Virtual environments
venv/
venvqAOPapp/
env/
ENV/
.venv/

# Tests
# `test_*.py` matches at the context root only, so the patterns below are
# needed for anything nested -- without them tests/ ships in the production
# image. Runtime files (api_v1.py, calibration.py, simulation_stats.py,
# openapi.yaml, llms.txt, templates/docs.html) must NOT be excluded here.
test_*.py
**/test_*.py
tests/
scripts/
requirements-dev.txt
pytest.ini
.pytest_cache/
.coverage
htmlcov/

# Secrets / environment (.env.example is kept as a template)
.env
.env.local
.env.*.local

# Temp / logs
.tmp/
tmp/
temp/
*.tmp
*.log

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Docker
Dockerfile
.dockerignore
